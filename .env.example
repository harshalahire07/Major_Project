# Application
APP_NAME=docverify
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=docverify
DATABASE_USER=docverify
DATABASE_PASSWORD=changeme

# LLM Provider
LLM_PROVIDER=local
LLM_MODEL_NAME=qwen3-4b-instruct

# Ollama (if using Ollama as runtime)
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Frontend
VITE_API_BASE_URL=http://localhost:8000
